APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://redis:6379/0
JOB_STORAGE_ROOT=/workspace/storage/jobs
ASSET_STORAGE_ROOT=/workspace/storage/assets
VIDEO_MANIFEST_SCHEMA_PATH=/workspace/packages/contracts/video-manifest.schema.json
RENDERER_URL=http://renderer:3001
RENDERER_TIMEOUT_SECONDS=600
PUBLIC_BASE_URL=http://localhost:8000

# CI/dev default. Set TTS_PROVIDER=openai only in the production pilot environment.
TTS_PROVIDER=espeak
ESPEAK_VOICE=vi
ESPEAK_RATE=145

# Production TTS. Keep the API key only in the server secret/environment, never commit it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TEXT_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Đọc tiếng Việt tự nhiên, rõ ràng, nhịp nhanh gọn và dứt khoát; phong cách tư vấn bất động sản chuyên nghiệp, giàu năng lượng nhưng không cường điệu; ngắt nghỉ ngắn giữa các ý.
OPENAI_TTS_TIMEOUT_SECONDS=120

NPD_BRAND_NAME=Ngoc Phuong Dong
NPD_LOGO_PATH=/workspace/storage/assets/brand/npd-logo.png

# Agent Hub Phase 2 integrations
VIDEO_API_URL=http://api:8000
AGENT_TOOL_TIMEOUT_SECONDS=30
ESPOCRM_URL=
ESPOCRM_API_KEY=
N8N_AGENT_EXECUTOR_WEBHOOK_URL=

# Agent Hub Phase 6 read-only marketing sources
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_GRAPH_VERSION=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_HOST_FILE=
GA4_SERVICE_ACCOUNT_FILE=/run/secrets/ga4-service-account.json
SOCIAL_INSIGHTS_URL=
SOCIAL_INSIGHTS_TOKEN=

# Agent Hub Phase 3 persistence
AGENT_STORE_BACKEND=redis
AGENT_REDIS_URL=redis://redis:6379/1
AGENT_STORE_NAMESPACE=npd:agent-hub:v1

# Agent Hub Phase 4 authentication / RBAC
# Use disabled only for local development/tests. Production should use static_token.
AGENT_AUTH_MODE=static_token
AGENT_VIEWER_TOKEN=
AGENT_OPERATOR_TOKEN=
AGENT_OWNER_TOKEN=

# Production pilot: require a real logo instead of the CI/dev placeholder.
PILOT_STRICT_ASSETS=0
