# Managed by scripts/phase5/caddy-cutover.sh.
# Add this block to /opt/n8n/Caddyfile, which is mounted read-only into
# n8n-marketing-caddy-1 at /etc/caddy/Caddyfile.
# Do not start a second Caddy instance. Replace only the placeholder hostname.
# The Caddy container reaches Agent Hub through n8n-marketing_n8n_net; container
# loopback (127.0.0.1) would point back to Caddy, not to the VPS host.

# BEGIN NPD AGENT HUB PHASE 5
agent-hub.example.invalid {
    encode zstd gzip

    reverse_proxy npd-agent-hub:8010 {
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=15552000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    log {
        output stdout
        format json
    }
}
# END NPD AGENT HUB PHASE 5
