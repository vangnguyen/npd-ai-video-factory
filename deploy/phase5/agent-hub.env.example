# Copy to /etc/npd-ai/agent-hub.env on the VPS.
# chmod 600 /etc/npd-ai/agent-hub.env
# Never commit the real values.

VIDEO_API_URL=http://api:8000
AGENT_TOOL_TIMEOUT_SECONDS=30

AGENT_STORE_BACKEND=redis
AGENT_REDIS_URL=redis://redis:6379/1
AGENT_STORE_NAMESPACE=npd:agent-hub:v1

AGENT_AUTH_MODE=static_token
AGENT_VIEWER_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_TOKEN_AT_LEAST_32_CHARS
AGENT_OPERATOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARS
AGENT_OWNER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARS

# Browser login uses Google only for identity verification. Bearer tokens stay enabled for
# smoke tests and non-browser automation. Create a dedicated Web OAuth client with redirect:
# https://mkt.ngocphuongdong.com/auth/google/callback
AGENT_BROWSER_AUTH_MODE=google_oidc
AGENT_PUBLIC_BASE_URL=https://mkt.ngocphuongdong.com
AGENT_GOOGLE_CLIENT_ID=REPLACE_WITH_DEDICATED_GOOGLE_WEB_CLIENT_ID
AGENT_GOOGLE_CLIENT_SECRET=REPLACE_WITH_DEDICATED_GOOGLE_WEB_CLIENT_SECRET
AGENT_SESSION_SIGNING_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARS
AGENT_SESSION_TTL_SECONDS=28800
AGENT_OWNER_EMAILS=nguyenvanvangct@gmail.com
AGENT_OPERATOR_EMAILS=
AGENT_VIEWER_EMAILS=

# Active key signs every new receipt. Historical keys are verify-only. Use dedicated
# random values; do not reuse bearer, OAuth, Meta or browser-session credentials.
AGENT_ATTRIBUTION_ACTIVE_SIGNING_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARS
AGENT_ATTRIBUTION_ACTIVE_KEY_ID=npd-attribution-v1
AGENT_ATTRIBUTION_VERIFICATION_KEYS_HOST_FILE=/etc/npd-ai/agent-attribution-verification-keys.json
AGENT_ATTRIBUTION_VERIFICATION_KEYS_FILE=/run/secrets/agent-attribution-verification-keys.json
# Backward-compatible aliases are accepted during migration. The guarded helper keeps
# them synchronized so an old rollback image can still read the active generation.
AGENT_ATTRIBUTION_RECEIPT_SIGNING_KEY=REPLACE_WITH_SAME_ACTIVE_SIGNING_KEY
AGENT_ATTRIBUTION_RECEIPT_KEY_ID=npd-attribution-v1
AGENT_ATTRIBUTION_DELIVERY_MAX_ATTEMPTS=4
# JSON mapping from producer name to freshness target in minutes.
AGENT_ATTRIBUTION_FRESHNESS_SLOS_JSON='{"n8n_lead_intake":15,"meta_ads":1440,"ga4":1440,"espocrm":1440,"utm":60}'
# Phase 8.8 evaluates cached provider state and heartbeat freshness only. It never
# calls providers, retries delivery or routes external notifications.
AGENT_PROVIDER_HEALTH_SCHEDULER_ENABLED=false
AGENT_PROVIDER_HEALTH_SCHEDULER_INTERVAL_SECONDS=300

# Read-only EspoCRM API user. Phase 5 preflight requires these for live CRM schema/mapping smoke tests.
ESPOCRM_URL=https://crm.ngocphuongdong.com
ESPOCRM_API_KEY=REPLACE_WITH_READ_ONLY_ESPOCRM_API_KEY
# Optional exact custom string field carrying a Phase 6B CMP-* ID on Opportunity.
# Keep blank until the field exists and its propagation has been accepted.
ESPOCRM_OPPORTUNITY_CAMPAIGN_FIELD=

# Phase 6 read-only marketing sources. Leave an entire source blank until a dedicated
# least-privilege credential has been reviewed. Do not reuse the production lead-ingestion token.
# META_ADS_ACCOUNT_ID accepts one ID or a comma-separated list of IDs.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Pin explicitly to a supported Graph version during credential onboarding.
META_GRAPH_VERSION=

GA4_PROPERTY_ID=
# The Compose host variable GA4_SERVICE_ACCOUNT_HOST_FILE points to the host JSON file.
# The application sees only this read-only mount path.
GA4_SERVICE_ACCOUNT_FILE=/run/secrets/ga4-service-account.json

# Dedicated Meta Page aggregate reader. It requests only Page identity/count fields and
# aggregate reaction/comment/share counts; it never requests post text or messages.
SOCIAL_META_PAGE_ID=
SOCIAL_META_ACCESS_TOKEN=
SOCIAL_META_GRAPH_VERSION=

# Optional legacy fixed HTTPS endpoint returning aggregate social metrics only. Leave
# blank when the native Meta Page reader above is configured.
SOCIAL_INSIGHTS_URL=
SOCIAL_INSIGHTS_TOKEN=

# Keep write execution disabled unless the existing n8n executor has been explicitly reviewed and activated.
N8N_AGENT_EXECUTOR_WEBHOOK_URL=
