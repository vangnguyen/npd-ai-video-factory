# Copy to /etc/npd-ai/agent-hub.env on the VPS.
# chmod 600 /etc/npd-ai/agent-hub.env
# Never commit the real values.

VIDEO_API_URL=http://api:8000
AGENT_TOOL_TIMEOUT_SECONDS=30

AGENT_STORE_BACKEND=redis
AGENT_REDIS_URL=redis://redis:6379/1
AGENT_STORE_NAMESPACE=npd:agent-hub:v1

AGENT_AUTH_MODE=static_token
AGENT_VIEWER_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_TOKEN_AT_LEAST_32_CHARS
AGENT_OPERATOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARS
AGENT_OWNER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_AT_LEAST_32_CHARS

# Read-only EspoCRM API user. Phase 5 preflight requires these for live CRM schema/mapping smoke tests.
ESPOCRM_URL=https://REPLACE_WITH_EXISTING_ESPOCRM_HOST
ESPOCRM_API_KEY=REPLACE_WITH_READ_ONLY_ESPOCRM_API_KEY

# Keep write execution disabled unless the existing n8n executor has been explicitly reviewed and activated.
N8N_AGENT_EXECUTOR_WEBHOOK_URL=
