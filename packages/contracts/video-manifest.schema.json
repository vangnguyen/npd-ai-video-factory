{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngocphuongdong.com/schemas/video-manifest.schema.json",
  "title": "NPD Video Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metadata", "brand", "scenes", "subtitles"],
  "properties": {
    "version": { "const": "1.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "project", "template", "duration_seconds", "fps", "width", "height", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "template": { "const": "real-estate-short-v1" },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "fps": { "type": "integer", "const": 30 },
        "width": { "type": "integer", "const": 1080 },
        "height": { "type": "integer", "const": 1920 },
        "language": { "const": "vi" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "logo_uri", "cta"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "logo_uri": { "type": "string", "minLength": 1 },
        "cta": { "type": "string", "minLength": 1, "maxLength": 160 },
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_uri"],
      "properties": {
        "audio_uri": { "type": "string", "minLength": 1 },
        "gain_db": { "type": "number", "minimum": -24, "maximum": 12 }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_uri", "gain_db"],
      "properties": {
        "audio_uri": { "type": "string", "minLength": 1 },
        "gain_db": { "type": "number", "minimum": -40, "maximum": 0 }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/scene" }
    },
    "subtitles": {
      "type": "array",
      "items": { "$ref": "#/$defs/subtitle" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_seconds", "duration_seconds", "role", "narration", "visual"],
      "properties": {
        "id": { "type": "string", "pattern": "^scene_[0-9]{2}$" },
        "start_seconds": { "type": "number", "minimum": 0 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "role": { "enum": ["hook", "identity", "information", "evidence", "sales_angle", "cta"] },
        "narration": { "type": "string", "minLength": 1 },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "uri"],
          "properties": {
            "type": { "enum": ["video", "image"] },
            "uri": { "type": "string", "minLength": 1 },
            "trim_start_seconds": { "type": "number", "minimum": 0 },
            "trim_end_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "fit": { "enum": ["cover", "contain"] }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headline": { "type": "string", "maxLength": 100 },
            "body": { "type": "string", "maxLength": 240 },
            "emphasis": { "type": "string", "maxLength": 60 }
          }
        }
      }
    },
    "subtitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "text"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  }
}
